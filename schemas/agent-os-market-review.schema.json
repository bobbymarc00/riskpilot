{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "symbol": {
      "type": "string",
      "pattern": "^[A-Z0-9]{5,20}$"
    },
    "best_bid": {
      "type": "string",
      "pattern": "^[0-9]+(?:\\.[0-9]+)?$"
    },
    "best_ask": {
      "type": "string",
      "pattern": "^[0-9]+(?:\\.[0-9]+)?$"
    },
    "last_price": {
      "type": "string",
      "pattern": "^[0-9]+(?:\\.[0-9]+)?$"
    },
    "change_24h_pct": {
      "type": "string",
      "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"
    },
    "source": {
      "type": "string",
      "enum": ["binance-agent-os"]
    },
    "review": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    }
  },
  "required": [
    "symbol",
    "best_bid",
    "best_ask",
    "last_price",
    "change_24h_pct",
    "source",
    "review"
  ]
}
