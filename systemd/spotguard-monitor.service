[Unit]
Description=RiskPilot deterministic Binance Spot prefilter
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/.openclaw/workspace/tools/spotguard-agent-os
Environment=SPOTGUARD_CONFIG=%h/.openclaw/workspace/tools/spotguard-agent-os/config.json
ExecStart=/usr/bin/env %h/.openclaw/workspace/tools/spotguard-agent-os/riskpilot --json scan --notify
Nice=10
IOSchedulingClass=idle
CPUQuota=50%
MemoryHigh=256M
MemoryMax=512M
TimeoutStartSec=90
NoNewPrivileges=true
PrivateTmp=true
